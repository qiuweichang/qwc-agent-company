  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "Web 只是控制台，真正执行者是本机 CLI 进程",
        "RuntimeStore 统一组合路由、状态、派单、运行和资源回收",
        "team 协议用 dispatch_id 把派单与回报闭环"
      ]
    },
    {
      "dot": "emerald",
      "title": "一致性与恢复",
      "items": [
        "SQLite 保存可追溯事实，内存只保留活跃运行快照",
        "派单投递失败时回滚消息和 ledger，避免假成功",
        "原生 session resume 失败时，用消息、未完任务和 tasks.md 重建上下文"
      ]
    },
    {
      "dot": "rose",
      "title": "边界与取舍",
      "items": [
        "Runtime 仅监听 127.0.0.1，UI 和 Agent 使用不同 token",
        "业务概览用轮询保持简单，高频终端流用 WebSocket",
        "CLI 拥有当前 Windows 用户权限，所以信任边界是本机与工作区"
      ]
    }
  ]
